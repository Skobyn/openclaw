{
  "id": "context-archive",
  "kind": "memory",
  "uiHints": {
    "embedding.apiKey": {
      "label": "Embedding API Key",
      "sensitive": true,
      "placeholder": "AIza... or sk-proj-...",
      "help": "API key for embeddings (or use ${GEMINI_API_KEY} / ${OPENAI_API_KEY})"
    },
    "embedding.provider": {
      "label": "Embedding Provider",
      "placeholder": "gemini",
      "help": "Embedding provider: gemini or openai"
    },
    "embedding.model": {
      "label": "Embedding Model",
      "placeholder": "gemini-embedding-001",
      "help": "Embedding model to use"
    },
    "embedding.baseUrl": {
      "label": "Base URL",
      "placeholder": "https://generativelanguage.googleapis.com/v1beta",
      "help": "Base URL for embedding API",
      "advanced": true
    },
    "embedding.dimensions": {
      "label": "Dimensions",
      "placeholder": "768",
      "help": "Vector dimensions (auto-detected for known models)",
      "advanced": true
    },
    "dbPath": {
      "label": "Database Path",
      "placeholder": "~/.openclaw/context-archive/archive.db",
      "advanced": true
    },
    "autoInject": {
      "label": "Auto-Inject",
      "help": "Automatically inject relevant archived context before agent starts"
    },
    "maxInjectChunks": {
      "label": "Max Inject Chunks",
      "help": "Maximum number of chunks to auto-inject",
      "advanced": true,
      "placeholder": "3"
    },
    "chunkTokens": {
      "label": "Chunk Size (tokens)",
      "help": "Target token count per archived chunk",
      "advanced": true,
      "placeholder": "512"
    },
    "consolidateAfter": {
      "label": "Consolidate After",
      "help": "Number of unconsolidated chunks before triggering consolidation",
      "advanced": true,
      "placeholder": "50"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "embedding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["gemini", "openai"]
          },
          "apiKey": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "dimensions": {
            "type": "number"
          }
        },
        "required": ["apiKey"]
      },
      "dbPath": {
        "type": "string"
      },
      "autoInject": {
        "type": "boolean"
      },
      "maxInjectChunks": {
        "type": "number",
        "minimum": 1,
        "maximum": 20
      },
      "chunkTokens": {
        "type": "number",
        "minimum": 128,
        "maximum": 4096
      },
      "consolidateAfter": {
        "type": "number",
        "minimum": 10,
        "maximum": 500
      }
    },
    "required": ["embedding"]
  }
}
