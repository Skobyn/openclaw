{
  "_comment": "Sanitized config template. Copy to ~/.clawdbot/clawdbot.json on the VM and fill in secrets.",
  "_note": "Plugin entries with configSchema MUST have a valid config even if disabled. Either provide full config or remove the entry.",
  "gateway": {
    "mode": "local",
    "token": "${OPENCLAW_GATEWAY_TOKEN}"
  },
  "hooks": {
    "enabled": true,
    "path": "/hooks",
    "token": "${HOOKS_TOKEN}",
    "mappings": [
      {
        "id": "gmail-inbox",
        "match": { "path": "/gmail" },
        "action": "agent",
        "wakeMode": "now",
        "messageTemplate": "📧 **New Email**\n\n**From:** {{from}}\n**Subject:** {{subject}}\n**Priority:** {{priority}}\n\n> {{body}}\n\n---\nShould I draft a reply, summarize, or mark for later?",
        "channel": "slack",
        "deliver": true,
        "to": "channel:${SLACK_DM_CHANNEL}"
      },
      {
        "id": "calendar-event",
        "match": { "path": "/calendar" },
        "action": "agent",
        "wakeMode": "now",
        "messageTemplate": "📅 **Upcoming: {{title}}**\n\n⏰ {{time}} ({{minutesUntil}} min from now)\n👥 {{attendees}}\n📍 {{location}}\n\n{{#if description}}📝 {{description}}{{/if}}\n\n---\nWant me to prep talking points, look up attendees, or remind you of relevant context?",
        "channel": "slack",
        "deliver": true,
        "to": "channel:${SLACK_DM_CHANNEL}"
      },
      {
        "id": "plaud-transcript",
        "match": { "path": "/plaud" },
        "action": "agent",
        "wakeMode": "now",
        "messageTemplate": "🎙️ **New Plaud Recording**\n\n**File:** {{fileName}}\n**Recorded:** {{recordedAt}}\n\n**Summary:**\n{{summary}}\n\n**Full Transcript:**\n{{transcript}}\n\n---\nAnalyze this and take appropriate action: create Motion tasks for action items, research topics that need investigation, develop ideas that are dev-related, and store everything in Ruvector for future reference.",
        "channel": "slack",
        "deliver": true,
        "to": "channel:${SLACK_DM_CHANNEL}"
      }
    ]
  },
  "plugins": {
    "entries": {
      "_note": "GEMINI_API_KEY is fetched from Secret Manager by fetch-secrets.sh and available as an env var. The ${GEMINI_API_KEY} reference is resolved at runtime by the plugin config loader.",
      "context-archive": {
        "config": {
          "embedding": {
            "provider": "gemini",
            "apiKey": "${GEMINI_API_KEY}"
          }
        }
      }
    }
  }
}
